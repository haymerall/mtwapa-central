{
  "name": "Member",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "default": "grace-sda"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "membership_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "transferred",
        "baptism_candidate"
      ],
      "default": "active"
    },
    "date_joined": {
      "type": "string",
      "format": "date"
    },
    "baptism_date": {
      "type": "string",
      "format": "date"
    },
    "ministries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "church_role": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "occupation": {
      "type": "string"
    },
    "spouse": {
      "type": "string"
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ]
}