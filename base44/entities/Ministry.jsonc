{
  "name": "Ministry",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "default": "grace-sda"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "leader": {
      "type": "string"
    },
    "leader_email": {
      "type": "string"
    },
    "members_count": {
      "type": "number",
      "default": 0
    },
    "color": {
      "type": "string"
    },
    "meeting_day": {
      "type": "string"
    },
    "meeting_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
