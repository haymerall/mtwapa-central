{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "default": "grace-sda"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ]
    },
    "category": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "reference": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "approved"
      ],
      "default": "completed"
    },
    "recorded_by": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "amount",
    "date"
  ]
}