{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "default": "grace-sda"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "enum": [
        "entire_church",
        "ministry",
        "members",
        "event_participants"
      ],
      "default": "entire_church"
    },
    "ministry": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "pending"
      ],
      "default": "published"
    }
  },
  "required": [
    "title",
    "date"
  ]
}