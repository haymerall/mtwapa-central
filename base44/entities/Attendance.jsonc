{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "default": "grace-sda"
    },
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "group": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "late",
        "excused"
      ],
      "default": "absent"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "recorded_by": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "member_id",
    "date"
  ]
}